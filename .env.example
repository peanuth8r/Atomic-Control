ATOMIC_DATABASE_URL=sqlite:///./atomic-control.db
ATOMIC_MODE=real
ATOMIC_DEV_AUTH=false
ATOMIC_OIDC_ISSUER=
ATOMIC_OIDC_JWKS_URL=
ATOMIC_OIDC_AUDIENCE=atomic-control
ATOMIC_OIDC_CLIENT_ID=
ATOMIC_OIDC_CLIENT_SECRET=
# Fixed browser login lifetime; access tokens refresh server-side within this window.
ATOMIC_BROWSER_SESSION_SECONDS=86400
# Owner-only file containing a persistent Fernet key; required for browser SSO.
ATOMIC_BROWSER_SESSION_KEY_FILE=
ATOMIC_PUBLIC_URL=https://control.example.invalid
ATOMIC_POLICY_FILE=config/authorization.yaml
ATOMIC_SIGNING_KEY_FILE=
# Optional single public root CA to include and trust in Windows agent packages.
# Never point this at a private key or a combined/system trust bundle.
ATOMIC_AGENT_PUBLIC_CA_FILE=
# MCP delegated-token exchange must preserve sub and atomic:* scopes.
ATOMIC_MCP_CLIENT_IDS=
ATOMIC_API_URL=https://control.example.invalid
ATOMIC_TOKEN_EXCHANGE_URL=
ATOMIC_MCP_CLIENT_ID=
ATOMIC_MCP_CLIENT_SECRET=
ATOMIC_MCP_RESOURCE=https://mcp.example.invalid/mcp

# Optional, server-only token for higher GitHub API rate limits. Never entered in the UI.
ATOMIC_GITHUB_TOKEN=
# Catalog approval authorizes compatible operator requests directly. Use per_run
# for optional subject-scoped permissions and a separate approval on every run.
ATOMIC_APPROVAL_MODE=catalog
# Durable actor batch lifetime; queued tests never dispatch after this deadline.
ATOMIC_QUEUE_LIFETIME_SECONDS=86400
# Download/verification deadline, separate from a test’s execution timeout.
ATOMIC_ARTIFACT_PREPARATION_SECONDS=300
# Durable central packaging, independent of actor download/verification.
ATOMIC_ARTIFACT_BUILD_SECONDS=300
ATOMIC_ARTIFACT_WORKER_ENABLED=true

# Optional administrator user creation; only the Keycloak adapter is supported.
ATOMIC_USER_MANAGEMENT_PROVIDER=disabled
ATOMIC_KEYCLOAK_MANAGEMENT_CLIENT_ID=
ATOMIC_KEYCLOAK_MANAGEMENT_CLIENT_SECRET=
