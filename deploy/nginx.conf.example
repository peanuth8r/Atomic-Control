# Put log_format in the nginx http context. Do not log query strings or headers.
log_format atomic_safe '$remote_addr $request_method $uri $status';
server {
    listen 443 ssl;
    server_name control.example.invalid;
    ssl_certificate /etc/atomic-control/tls/fullchain.pem;
    ssl_certificate_key /etc/atomic-control/tls/privkey.pem;
    access_log /var/log/nginx/atomic-control.log atomic_safe;
    client_max_body_size 200k;
    root /opt/atomic-control/apps/frontend/dist;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    location = /api/v1/catalog/uploads {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location ~ ^/(api/|auth/|health$|ready$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
