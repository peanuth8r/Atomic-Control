[Unit]
Description=Atomic Control Linux Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/atomic-control/venv/bin/python -I -m apps.agent.linux.service --config /etc/atomic-control/agent.json
WorkingDirectory=/opt/atomic-control
Environment=PYTHONNOUSERSITE=1
UMask=0077
Restart=no
KillMode=control-group
TimeoutStopSec=60
LimitCORE=0

[Install]
WantedBy=multi-user.target
